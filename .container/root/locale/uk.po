msgid "I2P console not responding (port: %s)"
msgstr "Консоль I2P не відповідає (порт: %s)"

#: .container/user/healthcheck.d/100-check-i2p-router-health.sh:26
msgid "I2P router is healthy (port: %s)"
msgstr "Маршрутизатор I2P працює справно (порт: %s)"

#: .container/user/command.d/generate-eepsite-key:12
msgid "Generating I2P eepsite identity key"
msgstr "Генерація ключа ідентичності eepsite I2P"

#: .container/user/command.d/generate-eepsite-key:19
msgid "Using i2pd for key generation"
msgstr "Для генерації ключа використовується i2pd"

#: .container/user/command.d/generate-eepsite-key:27
msgid "Using I2P Java for key generation"
msgstr "Для генерації ключа використовується I2P Java"

#: .container/user/command.d/generate-eepsite-key:47
msgid "Eepsite key generated successfully"
msgstr "Ключ eepsite успішно згенеровано"

#: .container/user/command.d/generate-eepsite-key:49
msgid "Failed to generate eepsite key"
msgstr "Не вдалося згенерувати ключ eepsite"

