msgid "Seeded %s subscriptions into %s"
msgstr "Засіяно підписок %s у %s"

#: .container/user/entrypoint.d/220-prepare-reseed.sh:23
msgid "Preset file %s unreadable, using only F5M_I2P_RESEED_URLS"
msgstr "Файл пресету %s нечитабельний, використовую лише F5M_I2P_RESEED_URLS"

