msgid "Keeping existing reseed proxy settings"
msgstr "Зберігаю наявні налаштування проксі ресиду"

#: .container/user/entrypoint.d/5000-start.sh:21
msgid "Directory %s not writable (owner %s) — wrapper will fail with Permission denied"
msgstr "Каталог %s недоступний для запису (власник %s) — wrapper завершиться з Permission denied"

#: .container/user/entrypoint.d/5000-start.sh:22
msgid "Attempting to fix permissions via chmod — if this fails, run once as root: docker run --rm -v <volume>:/vol alpine chown 1000:1000 /vol"
msgstr "Спроба виправити права через chmod — якщо не вдасться, виконай як root: docker run --rm -v <том>:/vol alpine chown 1000:1000 /vol"

#: .container/user/entrypoint.d/5000-start.sh:30
msgid "Still not writable: %s — aborting, fix the volume ownership"
msgstr "Досі недоступно для запису: %s — переривання, виправ власника тому"

#: .container/user/entrypoint.d/5000-start.sh:33
msgid "Recovered writability on %s"
msgstr "Відновлено запис у %s"

#: .container/user/entrypoint.d/5000-start.sh:45
msgid "Restoring missing %s to user dir"
msgstr "Відновлення відсутнього %s до каталогу користувача"

#: .container/user/entrypoint.d/5000-start.sh:54
msgid "Seeding %s in %s"
msgstr "Заповнення %s у %s"

#: .container/user/entrypoint.d/5000-start.sh:57
msgid "No command provided, will run %s"
msgstr "Команду не вказано, буде запущено %s"

