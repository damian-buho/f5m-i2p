msgid "Reseed proxy enabled but F5M_I2P_RESEED_PROXY is not host:port: %s"
msgstr "Проксі ресиду ввімкнено, але F5M_I2P_RESEED_PROXY не host:port: %s"

#: .container/user/entrypoint.d/220-prepare-reseed.sh:78
msgid "Seeded reseed proxy %s via %s:%s"
msgstr "Проксі ресиду засіяно %s через %s:%s"

