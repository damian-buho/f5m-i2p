msgid "Export %s"
msgstr "Експортувати %s"

#: .container/user/entrypoint.d/200-prepare-eepsite.sh:11
msgid "Creating eepsite directory"
msgstr "Створення директорії eepsite"

#: .container/user/entrypoint.d/200-prepare-eepsite.sh:20
msgid "Loading eepsite identity from secret %s"
msgstr "Завантаження ідентифікації eepsite з секрету %s"

#: .container/user/entrypoint.d/200-prepare-eepsite.sh:24
msgid "No eepsite identity at %s, I2P will generate on first tunnel start"
msgstr "Ідентичності eepsite в %s немає, I2P згенерує її під час першого запуску тунелю"

#: .container/user/entrypoint.d/200-prepare-eepsite.sh:30
msgid "Existing eepsite identity found at %s"
msgstr "Знайдено наявну ідентичність eepsite в %s"

#: .container/user/entrypoint.d/200-prepare-eepsite.sh:35
msgid "Eepsite destination: %s"
msgstr "Призначення eepsite: %s"

#: .container/user/entrypoint.d/200-prepare-eepsite.sh:37
msgid "Eepsite .b32.i2p address will be available after tunnel startup"
msgstr "Адреса .b32.i2p буде доступна після запуску тунелю"

#: .container/user/entrypoint.d/210-prepare-subscriptions.sh:12
msgid "Keeping existing addressbook subscriptions at %s"
msgstr "Зберігаю наявні підписки адресної книги в %s"

#: .container/user/entrypoint.d/210-prepare-subscriptions.sh:22
msgid "Preset file %s unreadable, using only F5M_I2P_SUBSCRIPTIONS_URLS"
msgstr "Файл пресету %s нечитабельний, використовую лише F5M_I2P_SUBSCRIPTIONS_URLS"

#: .container/user/entrypoint.d/210-prepare-subscriptions.sh:29
msgid "No addressbook subscriptions configured, the router will use its own default"
msgstr "Підписки адресної книги не налаштовано, роутер використає власні типові"

