msgid "No reseed URLs configured, the router will use its built-in list"
msgstr "URL ресиду не налаштовано, маршрутизатор використає вбудований список"

#: .container/user/entrypoint.d/220-prepare-reseed.sh:48
msgid "Unknown reseed proxy type %s, falling back to HTTP"
msgstr "Невідомий тип проксі ресиду %s, повертаюся до HTTP"

