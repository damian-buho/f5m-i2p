#encoding=UTF-8
#********************************************************************
# Wrapper Properties
#********************************************************************
# Managed by envsubst - do not edit at runtime

# Java Application
wrapper.java.command=java

# Java Main class
wrapper.java.mainclass=org.tanukisoftware.wrapper.WrapperSimpleApp

# Java Classpath (include wrapper.jar)
wrapper.java.classpath.1={{ ENV.B19_HOME }}/lib/*.jar

# Java Library Path (location of libwrapper.so)
wrapper.java.library.path.1={{ ENV.B19_HOME }}
wrapper.java.library.path.2={{ ENV.B19_HOME }}/lib

# Java Bits
wrapper.java.additional.auto_bits=FALSE

# Java Additional Parameters
wrapper.java.additional.1=-DloggerFilenameOverride=logs/log-router-@.txt
wrapper.java.additional.2=-Di2p.dir.base="{{ ENV.B19_HOME }}"
wrapper.java.additional.2.stripquotes=TRUE
# Java 25+: allow Tanuki wrapper native access without warnings
wrapper.java.additional.3=--enable-native-access=ALL-UNNAMED
# I2P extracts its native crypto lib (libjcpuid.so / libjbigi.so) to the Java
# tmp dir. The default TMPDIR is /tmp, which is noexec on hardened hosts — the
# lib then fails to load ("failed to map segment") and I2P falls back to
# pure-Java crypto, far too slow to build tunnels. Point the tmp dir at the
# XDG cache tree, which is writable AND executable.
wrapper.java.additional.4=-Djava.io.tmpdir={{ ENV.XDG_CACHE_HOME }}/tmp

# Application parameters
wrapper.app.parameter.1=net.i2p.router.Router

#********************************************************************
# Wrapper Logging Properties
#********************************************************************
wrapper.console.format=PM
{%- set _log_levels = {
    "error": "ERROR",
    "warn":  "WARN",
    "info":  "INFO",
    "debug": "DEBUG"
} %}
wrapper.console.loglevel={{ ENV.F5M_I2P_LOG_LEVEL | default(_log_levels[ENV.B19_VERBOSITY] | default("WARN")) }}

# Signal handling
wrapper.signal.mode.usr1=IGNORE
wrapper.signal.mode.usr2=IGNORE

# Exit code behavior
wrapper.on_exit.default=SHUTDOWN
wrapper.on_exit.0=SHUTDOWN
wrapper.on_exit.1=SHUTDOWN
wrapper.on_exit.10=RESTART
wrapper.on_exit.2=SHUTDOWN
wrapper.on_exit.3=SHUTDOWN
wrapper.on_exit.4=RESTART
wrapper.on_exit.5=RESTART

wrapper.jvm_exit.timeout=60
wrapper.restart.delay=15
wrapper.ping.interval=300
wrapper.ping.timeout=320
wrapper.use_system_time=false

#********************************************************************
# Wrapper General Properties
#********************************************************************
wrapper.ignore_sequence_gaps=TRUE
wrapper.console.title=I2P Service
wrapper.umask=0022
wrapper.java.umask=0022
wrapper.logfile.umask=0077

# Deadlock detection
wrapper.check.deadlock=TRUE
wrapper.check.deadlock.interval=3699
wrapper.check.deadlock.action=DUMP,RESTART
wrapper.check.deadlock.output=FULL
