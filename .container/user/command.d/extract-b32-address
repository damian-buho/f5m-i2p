set -eo pipefail

# Print the .b32.i2p address of an eepsite identity file (eepPriv.dat).

KEY_FILE="${1:-}"

if [ -z "${KEY_FILE}" ] || [ ! -f "${KEY_FILE}" ]
then
  echo "Usage: extract-b32-address <eepPriv.dat>" >&2
  exit 1
fi

# I2P's PrivateKeyFile prints "B32 : <addr>.b32.i2p" for an existing key without regenerating it
ADDR=$(java -cp "${B19_HOME}/lib/i2p.jar:${B19_HOME}/lib/router.jar" \
  net.i2p.data.PrivateKeyFile "${KEY_FILE}" 2>/dev/null \
  | awk '/^[[:space:]]*B32/ {print $NF}' \
  | head -1) || ADDR=""

if [ -z "${ADDR}" ]
then
  echo "ERROR: cannot extract .b32.i2p from ${KEY_FILE} (java PrivateKeyFile failed)" >&2
  exit 1
fi

echo "${ADDR}"
