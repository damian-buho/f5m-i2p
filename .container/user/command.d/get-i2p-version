  # I2P’s own version class: the slim runtime has no jar tool to read the manifest
  java -cp "${B19_HOME}/lib/router.jar:${B19_HOME}/lib/i2p.jar" net.i2p.router.RouterVersion | grep '^I2P Core version' | grep -oP '\d+\.\d+\.\d+'
